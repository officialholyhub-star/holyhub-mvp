NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Use npm run dev:stripe for matching CLI signing secret + TEST forwarding.
# A secret alone does not deliver events; Dashboard and CLI secrets differ.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
# Optional dedicated signing secret (32+ random bytes); otherwise the server-only service role key signs recovery cookies.
AUTH_RECOVERY_SECRET=
GOOGLE_PLACES_API_KEY=your_server_only_google_places_api_key

HOLYHUB_BUSINESS_ADDRESS="Your business contact address"

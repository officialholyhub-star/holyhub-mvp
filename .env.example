NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments remain disabled in this build. Only isolated, signed TEST webhook events
# are supported; live checkout/Connect/refund/payout integration is not complete.
HOLYHUB_STRIPE_WEBHOOKS_ENABLED=false
# Server-only values. Configure privately on the host; never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_WEBHOOK_SECRET=

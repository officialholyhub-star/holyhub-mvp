# Copy to .env.production.local for a local preflight, or configure in Vercel.
# No private backend key is required for signup, listings, approvals or images.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=https://app.holyhub.co.uk
# Optional anti-bot widget: also enable Turnstile with its SECRET in Supabase Auth.
# The site key is public; never put the Turnstile secret in a NEXT_PUBLIC variable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
HOLYHUB_LOCAL_DEMO=false
HOLYHUB_DEMO_SAMPLE_DATA=false
HOLYHUB_STRIPE_WEBHOOKS_ENABLED=false

{
  "name": "holyhub-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:codespace": "NEXT_PUBLIC_SITE_URL=https://${CODESPACE_NAME}-3000.app.github.dev next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:production": "node scripts/check-production.mjs --offline && next build",
    "check:production": "node scripts/check-production.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:marketplace": "playwright test --config playwright.marketplace.config.ts",
    "demo": "node scripts/demo.mjs",
    "demo:samples": "node scripts/demo.mjs --sample-data"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.3.4",
    "typescript": "^5.9.2"
  }
}
